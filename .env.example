# Restaurant Billing & Order Management System Configuration

APP_NAME="DinePOS"
APP_ENV="development"
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_TIMEZONE="Asia/Kolkata"
APP_SECRET="super-secret-key-change-in-production-random-bytes-32"

# Database Connection
# DB_DRIVER: "mysql" or "sqlite"
DB_DRIVER="mysql"

# MySQL / MariaDB Settings
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="dinner_pos"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"

# SQLite Settings (Used if DB_DRIVER=sqlite)
DB_SQLITE_PATH="storage/db/database.sqlite"

# Session & Security
SESSION_LIFETIME=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
